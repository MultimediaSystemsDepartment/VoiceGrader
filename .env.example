# Local development ports. Services bind to loopback only.
RLHF_PORT=8080
ASR_PORT=8000
COORDINATOR_POLL_INTERVAL=30
EVAL_MAX_SAMPLES=40

# Default local jobs API; existing campaigns keep their frozen provider.
TTS_BASE_URL=http://tts-api:8080
# GPU TTS engines require separately approved models and reference_voices assets.
COQUI_TOS_AGREED=0

# Internal default; use HTTPS for an RLHF service on a separate host.
# Provision its service token separately in the ASR read-only token mount.
VOICEGRADER_RLHF_URL=http://rlhf:8080

# Watch approved publications every 60 s; drain before restarting model workers.
VOICEGRADER_HOT_RELOAD=1
VOICEGRADER_ASR_URL=http://asr:8000
