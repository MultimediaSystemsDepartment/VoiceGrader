# Web image -- annotation UI only. No GPU required.
# Much smaller than the GPU image (~1 GB vs ~15 GB).
#
# Build: docker compose build web
# Run:   docker compose up web

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# libsndfile1 for soundfile (WAV encoding); ffmpeg for audio format fallback
RUN apt-get update && apt-get install -y --no-install-recommends \
        libsndfile1 \
        ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# CPU-only torch + torchaudio for MP3 support in utils/audio.py
RUN pip install --no-cache-dir \
        torch torchaudio \
        --index-url https://download.pytorch.org/whl/cpu

COPY requirements.web.txt .
RUN pip install --no-cache-dir -r requirements.web.txt

COPY . .

EXPOSE 8080
CMD ["uvicorn", "web.app:app", "--host", "0.0.0.0", "--port", "8080"]
